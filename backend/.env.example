# =============================================================================
# CONTRATO DE AMBIENTE — BACKEND (FastAPI / worker / rehearsal)
#
# Fonte de verdade das variáveis do runtime Python. Copie para `backend/.env.local`
# (dev, git-ignored) ou provisione via secret manager (produção). Este arquivo lista
# APENAS nomes e placeholders — NUNCA comite valores reais.
#
# Regra de escopo: variáveis de frontend (prefixo NEXT_PUBLIC_* e SUPABASE_SERVICE_ROLE_KEY)
# NÃO pertencem aqui — vivem em `frontend/.env.example`. Cada variável tem um único dono.
# =============================================================================

# --- Meta WhatsApp Cloud API -------------------------------------------------
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- Gemini / LLM ------------------------------------------------------------
# Chave usada pelo runtime do backend. Em produção, a chave de produção; em dev, uma
# chave ISOLADA (nunca a de produção — foi a causa do estouro de cota de jul/2026).
GEMINI_API_KEY=
# Chave Gemini DEDICADA de desenvolvimento, exigida pelos runners de rehearsal
# (scripts.rehearsal.gemini_actor.require_isolated_gemini_key). Precisa existir e ser
# DIFERENTE da chave de produção; do contrário o harness aborta.
GEMINI_API_KEY_DEV=
# Kill-switch de gasto diário (USD). Env AUSENTE = 8 USD (armado por default desde o
# FinOps P0 de 12/07 — ~3x o pico diário observado). 0 explícito DESLIGA. Ao estourar,
# corte automático com fallback de handoff + alerta (wartime T1/T2).
LLM_DAILY_COST_LIMIT_USD=8
# Thinking da 1ª chamada do agente: off (default desde FinOps P0 12/07 — thinking dividia
# o budget de saída e causava ~10% de respostas vazias + retries; o retry-on-empty agora
# LIGA o thinking como fallback condicional) | on (rollback integral do comportamento
# antigo: inicial pensa, retry sem thinking). Chamadas mecânicas: sempre thinking off.
LLM_INITIAL_THINKING=off
# Roteamento de modelo das tarefas MECÂNICAS (FinOps 08/07): defaults em flash-lite
# (1/3 do input, 1/6 do output do 2.5-flash). Sobrescreva para reverter SEM deploy.
# Transcrição de áudio do WhatsApp (generateContent + inline_data, thinking off):
TRANSCRIPTION_MODEL=gemini-2.5-flash-lite
# Dossiê do Lead / rolling summary (merge estruturado de JSON no worker):
MEMORY_MODEL=gemini-2.5-flash-lite

# --- Supabase ----------------------------------------------------------------
# Em dev, aponte para o projeto de HOMOLOGAÇÃO; a produção é provisionada só no deploy.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Redis -------------------------------------------------------------------
# Dentro de container: redis://redis:6379 | no host (dev): redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# --- App ---------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:3000
IS_DEV_ENV=true

# --- Dev Router (isolamento de testes) ---------------------------------------
DEV_API_KEY=
DEV_SERVER_URL=http://127.0.0.1:8001
DEV_BACKEND_URL=http://127.0.0.1:8001

# --- Rehearsal (simulações de conversa) --------------------------------------
REHEARSAL_MODE=false
REHEARSAL_PHONE=
REHEARSAL_TURN_TIMEOUT=60
REHEARSAL_MAX_TURNS=20

# --- Operacional -------------------------------------------------------------
# Telefones autorizados a usar o comando !resetar (CSV).
RESET_ALLOWED_PHONES=
# Canais (phone_number_id, CSV) que respondem com IA.
AI_PHONE_NUMBER_ID=

# --- Observabilidade -----------------------------------------------------------
# Formato de log: json (default, producao) ou text (leitura humana em dev local).
LOG_FORMAT=json
# DSN do Sentry (captura de excecoes). VAZIO = desativado (fail-open, zero efeito).
SENTRY_DSN=

# --- Alertas externos (wartime T2, 10/07) --------------------------------------
# WhatsApp do operador (E.164, so digitos) que recebe alertas critical. VAZIO = off.
ADMIN_ALERT_PHONE=
# Canal Meta usado no envio do alerta. VAZIO = usa o primeiro canal ativo.
ALERT_CHANNEL_ID=

# --- Broadcast (wartime T3, 10/07) ----------------------------------------------
# Pre-flight de template no /start do broadcast (existencia/aprovacao, locale, params
# do BODY, header de midia). on (default) | off = kill-switch de emergencia sem deploy
# (fail-closed: sem conseguir verificar o template, o disparo e BLOQUEADO).
PREFLIGHT_TEMPLATE=on

# --- Parking de exaustao de budget/quota (wartime T1, 10/07) --------------------
# Folga (minutos) apos o reset do budget/quota antes do deadline do parking exausto.
LLM_PARK_EXHAUSTED_GRACE_MINUTES=30
# Teto duro (horas) do parking exausto — vencido, cai no handoff visivel.
LLM_PARK_EXHAUSTED_MAX_HOURS=26
# Throttle (minutos) de retry do drain para reason=quota (nao queimar RPM por tick).
LLM_PARK_RETRY_MINUTES=5
# Cooldown (horas) da mensagem de espera por conversa (llm:hold_msg:{conversation_id}).
LLM_HOLD_MSG_COOLDOWN_HOURS=6
