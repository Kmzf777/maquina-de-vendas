# =============================================================================
# CONTRATO DE AMBIENTE — BACKEND (FastAPI / worker / rehearsal)
#
# Fonte de verdade das variáveis do runtime Python. Copie para `backend/.env.local`
# (dev, git-ignored) ou provisione via secret manager (produção). Este arquivo lista
# APENAS nomes e placeholders — NUNCA comite valores reais.
#
# Regra de escopo: variáveis de frontend (prefixo NEXT_PUBLIC_* e SUPABASE_SERVICE_ROLE_KEY)
# NÃO pertencem aqui — vivem em `frontend/.env.example`. Cada variável tem um único dono.
# =============================================================================

# --- Meta WhatsApp Cloud API -------------------------------------------------
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- Gemini / LLM ------------------------------------------------------------
# Chave usada pelo runtime do backend. Em produção, a chave de produção; em dev, uma
# chave ISOLADA (nunca a de produção — foi a causa do estouro de cota de jul/2026).
GEMINI_API_KEY=
# Chave Gemini DEDICADA de desenvolvimento, exigida pelos runners de rehearsal
# (scripts.rehearsal.gemini_actor.require_isolated_gemini_key). Precisa existir e ser
# DIFERENTE da chave de produção; do contrário o harness aborta.
GEMINI_API_KEY_DEV=
# Kill-switch de gasto diário (USD). 0 ou ausente = DESLIGADO (default seguro). Defina um
# teto para armar o corte automático (fallback handoff) quando o custo do dia estourar.
LLM_DAILY_COST_LIMIT_USD=0
# Thinking da 1ª chamada do agente: on (default, preserva qualidade de raciocínio) | off
# (troca qualidade por custo). As chamadas mecânicas já rodam sempre com thinking off.
LLM_INITIAL_THINKING=on

# --- Supabase ----------------------------------------------------------------
# Em dev, aponte para o projeto de HOMOLOGAÇÃO; a produção é provisionada só no deploy.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Redis -------------------------------------------------------------------
# Dentro de container: redis://redis:6379 | no host (dev): redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# --- App ---------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:3000
IS_DEV_ENV=true

# --- Dev Router (isolamento de testes) ---------------------------------------
DEV_API_KEY=
DEV_SERVER_URL=http://127.0.0.1:8001
DEV_BACKEND_URL=http://127.0.0.1:8001

# --- Rehearsal (simulações de conversa) --------------------------------------
REHEARSAL_MODE=false
REHEARSAL_PHONE=
REHEARSAL_TURN_TIMEOUT=60
REHEARSAL_MAX_TURNS=20

# --- Operacional -------------------------------------------------------------
# Telefones autorizados a usar o comando !resetar (CSV).
RESET_ALLOWED_PHONES=
# Canais (phone_number_id, CSV) que respondem com IA.
AI_PHONE_NUMBER_ID=
