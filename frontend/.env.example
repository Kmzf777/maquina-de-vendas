# =============================================================================
# CONTRATO DE AMBIENTE — FRONTEND (Next.js App Router)
#
# Fonte de verdade das variáveis do runtime Next.js. Copie para `frontend/.env.local`
# (dev, git-ignored, carregado automaticamente pelo Next). Este arquivo lista APENAS
# nomes e placeholders — NUNCA comite valores reais.
#
# PÚBLICO vs SECRETO: apenas variáveis com prefixo NEXT_PUBLIC_ são embutidas no bundle
# do browser. NUNCA coloque um segredo atrás desse prefixo. As demais ficam restritas ao
# servidor (Server Components / Route Handlers) e nunca vazam para o cliente.
# =============================================================================

# --- Público (exposto ao browser) -------------------------------------------
NEXT_PUBLIC_FASTAPI_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Segredos do servidor (nunca expostos ao browser) ------------------------
# Service role do Supabase, usada só em código de servidor (getServiceSupabase()).
SUPABASE_SERVICE_ROLE_KEY=
# Envio direto de WhatsApp a partir das rotas de API do Next.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=

# Multiplicador USD->BRL do card de custo de IA em /estatisticas (cambio medio +
# impostos da fatura Google Brasil). Default no codigo: 5.73 (conciliacao 11/07:
# $2,39 -> R$13,70). Ajuste quando cambio/imposto mudarem — so exibicao, nao afeta USD.
CUSTO_IA_MULTIPLICADOR_BRL=5.73
